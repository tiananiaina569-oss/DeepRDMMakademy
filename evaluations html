          Tous
        </button>

        <button class="filter" data-filter="science">
          Science
        </button>

        <button class="filter" data-filter="maths">
          Maths
        </button>

        <button class="filter" data-filter="physique">
          Physique
        </button>

        <button class="filter" data-filter="biologie">
          Biologie
        </button>

        <button class="filter" data-filter="ia">
          IA
        </button>

        <button class="filter" data-filter="digital">
          Digital
        </button>

      </div>

      <input
        class="search"
        id="search"
        type="search"
        placeholder="Rechercher une évaluation..."
      >

      <div class="eval-grid" id="evalGrid">

        <!-- SCIENCE -->

        <article class="eval-card" data-category="science">

          <div class="eval-top">
            <span class="code">EVAL-SCI-001</span>
            <span class="badge">DISPONIBLE</span>
          </div>

          <h3>Méthode scientifique</h3>

          <p>
            Vérification des connaissances fondamentales sur
            l'observation, l'hypothèse, l'expérience et l'analyse.
          </p>

          <div class="meta">
            <span>COLLÈGE</span>
            <span>20 QUESTIONS</span>
            <span>30 MIN</span>
          </div>

          <a class="btn primary" href="#assessment">
            COMMENCER →
          </a>

        </article>

        <!-- MATHS -->

        <article class="eval-card" data-category="maths">

          <div class="eval-top">
            <span class="code">EVAL-MAT-002</span>
            <span class="badge">DISPONIBLE</span>
          </div>

          <h3>Fondamentaux mathématiques</h3>

          <p>
            Évaluation des compétences de calcul, logique,
            résolution de problèmes et raisonnement.
          </p>

          <div class="meta">
            <span>5e</span>
            <span>25 QUESTIONS</span>
            <span>40 MIN</span>
          </div>

          <a class="btn primary" href="#assessment">
            COMMENCER →
          </a>

        </article>

        <!-- PHYSIQUE -->

        <article class="eval-card" data-category="physique">

          <div class="eval-top">
            <span class="code">EVAL-PHY-003</span>
            <span class="badge">DISPONIBLE</span>
          </div>

          <h3>Physique fondamentale</h3>

          <p>
            Concepts fondamentaux : mouvement, forces, énergie
            et analyse des phénomènes physiques.
          </p>

          <div class="meta">
            <span>LYCÉE</span>
            <span>20 QUESTIONS</span>
            <span>35 MIN</span>
          </div>

          <a class="btn primary" href="#assessment">
            COMMENCER →
          </a>

        </article>

        <!-- BIOLOGIE -->

        <article class="eval-card" data-category="biologie">

          <div class="eval-top">
            <span class="code">EVAL-BIO-004</span>
            <span class="badge">DISPONIBLE</span>
          </div>

          <h3>Biologie & Génétique</h3>

          <p>
            Évaluation des bases de la cellule, génétique,
            information biologique et systèmes vivants.
          </p>

          <div class="meta">
            <span>UNIVERSITÉ</span>
            <span>25 QUESTIONS</span>
            <span>45 MIN</span>
          </div>

          <a class="btn primary" href="#assessment">
            COMMENCER →
          </a>

        </article>

        <!-- IA -->

        <article class="eval-card" data-category="ia">

          <div class="eval-top">
            <span class="code">EVAL-AI-005</span>
            <span class="badge">DISPONIBLE</span>
          </div>

          <h3>Introduction à l'IA</h3>

          <p>
            Vérification des connaissances sur les données,
            algorithmes, apprentissage automatique et modèles.
          </p>

          <div class="meta">
            <span>UNIVERSITÉ</span>
            <span>20 QUESTIONS</span>
            <span>40 MIN</span>
          </div>

          <a class="btn primary" href="#assessment">
            COMMENCER →
          </a>

        </article>

        <!-- DIGITAL -->

        <article class="eval-card" data-category="digital">

          <div class="eval-top">
            <span class="code">EVAL-DIG-006</span>
            <span class="badge">DISPONIBLE</span>
          </div>

