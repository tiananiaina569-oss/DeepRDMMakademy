<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="DeepRDMMakademy — Centre d'évaluation scientifique et académique.">
<title>Evaluations — DeepRDMMakademy</title>

<style>
:root{
  --bg:#05080d;
  --panel:#0a1018;
  --panel2:#0d1621;
  --cyan:#20d9ff;
  --blue:#1877ff;
  --gold:#d9b65d;
  --text:#edf7ff;
  --muted:#8da1b5;
  --line:rgba(32,217,255,.18);
  --green:#45e0a1;
  --red:#ff6878;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:
    radial-gradient(circle at 15% 0%,rgba(24,119,255,.14),transparent 35%),
    radial-gradient(circle at 85% 20%,rgba(32,217,255,.08),transparent 30%),
    var(--bg);
  color:var(--text);
  line-height:1.6;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
input{
  font:inherit;
}

.container{
  width:min(1120px,92%);
  margin:auto;
}

/* HEADER */

header{
  position:sticky;
  top:0;
  z-index:100;
  backdrop-filter:blur(16px);
  background:rgba(5,8,13,.9);
  border-bottom:1px solid var(--line);
}

.nav{
  min-height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.brand{
  font-family:Georgia,serif;
  font-size:1.05rem;
  font-weight:700;
  letter-spacing:.04em;
}

.brand span{
  color:var(--cyan);
}

.status{
  display:flex;
  align-items:center;
  gap:7px;
  font-family:monospace;
  font-size:.65rem;
  letter-spacing:.1em;
  color:var(--green);
  white-space:nowrap;
}

.status i{
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--green);
  box-shadow:0 0 12px var(--green);
}

.top-links{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:0 0 10px;
  scrollbar-width:none;
}

.top-links::-webkit-scrollbar{
  display:none;
}

.top-links a{
  flex:0 0 auto;
  padding:7px 10px;
  border:1px solid var(--line);
  color:var(--muted);
  font-size:.72rem;
  border-radius:5px;
}

.top-links a:hover{
  color:var(--cyan);
  border-color:rgba(32,217,255,.45);
}

/* HERO */

.hero{
  padding:65px 0 40px;
  text-align:center;
}

.eyebrow{
  color:var(--gold);
  font-family:monospace;
  font-size:.7rem;
  letter-spacing:.18em;
  margin-bottom:15px;
}

.hero h1{
  font-family:Georgia,serif;
  font-size:clamp(2.1rem,8vw,4.5rem);
  line-height:1.05;
  font-weight:500;
  margin-bottom:18px;
}

.hero h1 span{
  color:var(--cyan);
}

.hero p{
  max-width:700px;
  margin:auto;
  color:var(--muted);
  font-size:.96rem;
}

/* METRICS */

.metrics{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  margin:20px 0 45px;
}

.metric{
  padding:20px 14px;
  background:linear-gradient(145deg,var(--panel2),var(--panel));
  border:1px solid var(--line);
  border-radius:8px;
}

.metric strong{
  display:block;
  color:var(--cyan);
  font-family:monospace;
  font-size:1.55rem;
}

.metric span{
  color:var(--muted);
  font-size:.7rem;
  text-transform:uppercase;
  letter-spacing:.1em;
}

/* SECTIONS */

section{
  margin:55px 0;
}

.section-label{
  color:var(--gold);
  font-family:monospace;
  font-size:.68rem;
  letter-spacing:.18em;
  margin-bottom:8px;
}

.section-title{
  font-family:Georgia,serif;
  font-size:1.8rem;
  font-weight:500;
  margin-bottom:10px;
}

.section-desc{
  color:var(--muted);
  font-size:.85rem;
  max-width:720px;
}

/* CORE */

.core{
  display:grid;
  gap:18px;
}

.core-visual{
  min-height:250px;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(circle,rgba(32,217,255,.16),transparent 28%),
    var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
}

.ring{
  position:absolute;
  width:170px;
  height:170px;
  border:1px solid rgba(32,217,255,.28);
  border-radius:50%;
  animation:spin 14s linear infinite;
}

.ring:nth-child(2){
  width:120px;
  height:120px;
  border-color:rgba(217,182,93,.4);
  animation-duration:9s;
  animation-direction:reverse;
}

.ring:nth-child(3){
  width:210px;
  height:210px;
  border-style:dashed;
  animation-duration:20s;
}

.core-center{
  position:relative;
  z-index:2;
  width:82px;
  height:82px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:#08121d;
  border:1px solid var(--cyan);
  box-shadow:0 0 35px rgba(32,217,255,.18);
  color:var(--cyan);
  font-family:monospace;
  font-size:.7rem;
}

@keyframes spin{
  to{
    transform:rotate(360deg);
  }
}

.core-info{
  display:grid;
  gap:10px;
}

.info-card{
  padding:18px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
}

.info-card h3{
  font-size:.95rem;
  margin-bottom:5px;
}

.info-card p{
  color:var(--muted);
  font-size:.78rem;
}

/* REGISTRY */

.registry{
  margin-top:25px;
}

.filters{
  display:flex;
  gap:7px;
  overflow-x:auto;
  padding-bottom:10px;
  scrollbar-width:none;
}

.filters::-webkit-scrollbar{
  display:none;
}

.filter{
  flex:0 0 auto;
  padding:8px 12px;
  background:var(--panel);
  color:var(--muted);
  border:1px solid var(--line);
  border-radius:5px;
  cursor:pointer;
  font-size:.7rem;
}

.filter.active,
.filter:hover{
  color:var(--cyan);
  border-color:var(--cyan);
}

.search{
  width:100%;
  margin:10px 0 20px;
  padding:13px 14px;
  background:#070c12;
  color:var(--text);
  border:1px solid var(--line);
  border-radius:6px;
  outline:none;
}

.search:focus{
  border-color:var(--cyan);
}

.eval-grid{
  display:grid;
  gap:12px;
}

.eval-card{
  background:linear-gradient(145deg,var(--panel2),var(--panel));
  border:1px solid var(--line);
  border-radius:8px;
  padding:19px;
  transition:.2s;
}

.eval-card:hover{
  transform:translateY(-2px);
  border-color:rgba(32,217,255,.4);
}

.eval-top{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
}

.code{
  color:var(--gold);
  font-family:monospace;
  font-size:.66rem;
}

.badge{
  padding:4px 7px;
  border-radius:4px;
  font-family:monospace;
  font-size:.58rem;
  color:var(--green);
  border:1px solid rgba(69,224,161,.25);
}

.eval-card h3{
  font-family:Georgia,serif;
  font-size:1.15rem;
  font-weight:500;
  margin-bottom:7px;
}

.eval-card p{
  color:var(--muted);
  font-size:.76rem;
  margin-bottom:14px;
}

.meta{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:16px;
}

.meta span{
  padding:5px 7px;
  background:#07101a;
  border:1px solid rgba(255,255,255,.06);
  color:#9fb2c5;
  font-family:monospace;
  font-size:.58rem;
}

.btn{
  display:inline-flex;
  justify-content:center;
  align-items:center;
  min-height:42px;
  padding:10px 14px;
  border-radius:5px;
  font-family:monospace;
  font-size:.68rem;
  letter-spacing:.04em;
  border:1px solid var(--cyan);
  color:var(--cyan);
  background:rgba(32,217,255,.04);
  cursor:pointer;
}

.btn:hover{
  background:rgba(32,217,255,.1);
}

.btn.primary{
  background:var(--cyan);
  color:#031018;
  font-weight:700;
}

/* ENGINE */

.engine{
  display:grid;
  gap:16px;
}

.engine-panel{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:9px;
  padding:20px;
}

.engine-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:15px;
}

.engine-header h3{
  font-family:Georgia,serif;
  font-weight:500;
}

.timer{
  color:var(--gold);
  font-family:monospace;
  font-size:.8rem;
}

.progress-wrap{
  margin-bottom:20px;
}

.progress-info{
  display:flex;
  justify-content:space-between;
  color:var(--muted);
  font-family:monospace;
  font-size:.62rem;
  margin-bottom:7px;
}

.progress{
  height:6px;
  background:#071019;
  border-radius:10px;
  overflow:hidden;
}

.progress span{
  display:block;
  width:5%;
  height:100%;
  background:var(--cyan);
  box-shadow:0 0 12px rgba(32,217,255,.5);
}

.question{
  font-family:Georgia,serif;
  font-size:1.15rem;
  margin-bottom:18px;
}

.answers{
  display:grid;
  gap:8px;
}

.answer{
  width:100%;
  text-align:left;
  padding:13px;
  background:#071019;
  color:var(--text);
  border:1px solid var(--line);
  border-radius:6px;
  cursor:pointer;
}

.answer:hover{
  border-color:var(--cyan);
}

.answer.selected{
  border-color:var(--cyan);
  background:rgba(32,217,255,.08);
}

.answer.correct{
  border-color:var(--green);
  background:rgba(69,224,161,.08);
}

.answer.wrong{
  border-color:var(--red);
  background:rgba(255,104,120,.08);
}

.feedback{
  display:none;
  margin-top:14px;
  padding:12px;
  border-radius:6px;
  font-size:.76rem;
  background:#071019;
  color:var(--muted);
}

.engine-actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:16px;
}

/* SECURITY */

.rules{
  display:grid;
  gap:10px;
}

.rule{
  display:flex;
  gap:12px;
  padding:17px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
}

.rule-number{
  color:var(--gold);
  font-family:monospace;
  font-size:.7rem;
}

.rule h3{
  font-size:.86rem;
  margin-bottom:3px;
}

.rule p{
  color:var(--muted);
  font-size:.72rem;
}

/* PATH */

.path{
  display:grid;
  gap:8px;
}

.path-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px;
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:6px;
}

.path-item:hover{
  border-color:rgba(32,217,255,.45);
}

.path-num{
  min-width:30px;
  height:30px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#07131e;
  color:var(--cyan);
  font-family:monospace;
  font-size:.7rem;
}

.path-item strong{
  display:block;
  font-size:.78rem;
}

.path-item span{
  color:var(--muted);
  font-size:.67rem;
}

/* CONTROL */

.control-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:9px;
  margin-top:20px;
}

.control{
  padding:16px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:7px;
}

.control:hover{
  border-color:rgba(32,217,255,.45);
}

.control strong{
  display:block;
  color:var(--cyan);
  font-family:monospace;
  font-size:.7rem;
  margin-bottom:5px;
}

.control span{
  color:var(--muted);
  font-size:.7rem;
}

/* FOOTER */

footer{
  margin-top:70px;
  padding:35px 0;
  border-top:1px solid var(--line);
}

.footer-grid{
  display:grid;
  gap:22px;
}

.footer-brand{
  font-family:Georgia,serif;
  font-size:1rem;
}

.footer-brand span{
  color:var(--cyan);
}

footer p{
  color:var(--muted);
  font-size:.7rem;
  max-width:520px;
}

.footer-links{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.footer-links a{
  color:var(--muted);
  font-family:monospace;
  font-size:.63rem;
}

.footer-links a:hover{
  color:var(--cyan);
}

/* RESPONSIVE */

@media(min-width:700px){

  .metrics{
    grid-template-columns:repeat(4,1fr);
  }

  .core{
    grid-template-columns:1.1fr .9fr;
  }

  .eval-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .rules{
    grid-template-columns:repeat(2,1fr);
  }

  .path{
    grid-template-columns:repeat(2,1fr);
  }

  .footer-grid{
    grid-template-columns:1fr auto;
    align-items:end;
  }
}

@media(min-width:1000px){

  .eval-grid{
    grid-template-columns:repeat(3,1fr);
  }

  .path{
    grid-template-columns:repeat(3,1fr);
  }

  .control-grid{
    grid-template-columns:repeat(3,1fr);
  }
}
</style>
</head>

