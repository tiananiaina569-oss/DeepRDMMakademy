<main>

<!-- HERO -->

<section class="hero">

  <div class="container">

    <div class="eyebrow">
      AKADEMY // EVALUATION CENTER
    </div>

    <h1>
      Évaluer.<br>
      <span>Valider.</span> Progresser.
    </h1>

    <p>
      Un système d'évaluation structuré pour mesurer les compétences,
      identifier les difficultés et valider chaque étape du parcours
      académique.
    </p>

  </div>

</section>

<!-- METRICS -->

<section>

  <div class="container">

    <div class="metrics">

      <div class="metric">
        <strong>120+</strong>
        <span>Évaluations prévues</span>
      </div>

      <div class="metric">
        <strong>07</strong>
        <span>Domaines</span>
      </div>

      <div class="metric">
        <strong>42+</strong>
        <span>Compétences</span>
      </div>

      <div class="metric">
        <strong>02</strong>
        <span>Langues</span>
      </div>

    </div>

  </div>

</section>

<!-- CORE -->

<section>

  <div class="container">

    <div class="section-label">
      01 // EVALUATION CORE
    </div>

    <h2 class="section-title">
      Le moteur d'évaluation.
    </h2>

    <p class="section-desc">
      Chaque évaluation est reliée au niveau, à la matière, au chapitre,
      aux compétences et aux prérequis de l'étudiant.
    </p>

    <div class="core" style="margin-top:25px">

      <div class="core-visual">

        <div class="ring"></div>
        <div class="ring"></div>
        <div class="ring"></div>

        <div class="core-center">
          ASSESSMENT<br>
          CORE
        </div>

      </div>

      <div class="core-info">

        <div class="info-card">
          <h3>Évaluation adaptative</h3>
          <p>
            Les questions peuvent être sélectionnées selon le niveau,
            la compétence ciblée et les résultats précédents.
          </p>
        </div>

        <div class="info-card">
          <h3>Validation académique</h3>
          <p>
            Une compétence validée permet au système de débloquer
            l'étape pédagogique suivante.
          </p>
        </div>

        <div class="info-card">
          <h3>Remédiation</h3>
          <p>
            Les erreurs sont analysées afin de proposer des exercices
            ciblés avant une nouvelle tentative.
          </p>
        </div>

      </div>

    </div>

  </div>

</section>

<!-- REGISTRY -->

<section>

  <div class="container">

    <div class="section-label">
      02 // REGISTRY
    </div>

    <h2 class="section-title">
      Évaluations disponibles.
    </h2>

    <p class="section-desc">
      Sélectionnez une évaluation correspondant à votre parcours.
    </p>

    <div class="registry">

      <div class="filters">

